{
  "id": "verdant",
  "name": "Verdant",
  "hosts": [
    "verdant.example.com",
    "verdant.localhost"
  ],
  "theme": {
    "accent": [
      "#2F7D4F",
      "#5FCB85"
    ],
    "neutralStyle": "cool",
    "contrast": "high",
    "radius": "round",
    "tokens": {},
    "typography": {
      "scale": {
        "base": 15,
        "ratio": 1.125
      },
      "body": {
        "family": "DM Sans",
        "fallbacks": "-apple-system, system-ui, sans-serif",
        "source": {
          "type": "google",
          "axes": "wght@400;500;700"
        }
      },
      "heading": {
        "weight": "medium"
      }
    },
    "motion": {
      "fast": 100,
      "medium": 250,
      "slow": 600,
      "ratio": 0.8
    }
  },
  "assets": {
    "logo": "/brands/verdant/logo.svg",
    "favicon": "/brands/verdant/favicon.svg"
  },
  "copy": {
    "hero.title": "Plant-forward, every plate",
    "hero.subtitle": "Vegetables with the main-character treatment.",
    "nav.cta": "Reserve"
  },
  "runtime": {
    "supportEmail": "hello@verdant.example.com"
  }
}
