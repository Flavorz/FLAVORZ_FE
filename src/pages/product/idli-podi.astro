---
import FzLayout from '../../layouts/FzLayout.astro';
import ProductGallery from '../../components/fz/ProductGallery.astro';
import ProductInfo from '../../components/fz/ProductInfo.astro';
import MakerCard from '../../components/fz/MakerCard.astro';

const crumbs = [
  { label: 'Home', href: '/fz/' },
  { label: 'Shop', href: '/shop' },
  { label: 'Podi', href: '/shop' },
  { label: 'Idli podi' },
];
---

<FzLayout title="Idli podi · Flavorz" crumbs={crumbs} cartCount={3}>
  <div class="fz-shell fz-pdp-grid">
    <ProductGallery />
    <ProductInfo />
  </div>
  <div class="fz-shell">
    <MakerCard />
  </div>
</FzLayout>

<style>
  .fz-pdp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    margin-top: 28px;
    align-items: start;
  }

  @media (max-width: 860px) {
    .fz-pdp-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
