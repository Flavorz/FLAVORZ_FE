---
const { title, note, action } = Astro.props;
---

<div class="fz-head">
  <div class="fz-head__main">
    <h2>{title}</h2>
    {note && <span class="fz-head__note">{note}</span>}
  </div>
  {action && (
    <a class="fz-head__action" href="#">{action}</a>
  )}
</div>

<style>
  .fz-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    /* 62px from heading top to content top; the heading box is 38 tall. */
    margin-bottom: calc(var(--fz-head-gap) - 38px);
  }

  .fz-head h2 {
    font-family: var(--fz-font-display);
    font-size: var(--fz-h1-size);
    line-height: var(--fz-h1-lh);
    margin: 0;
  }

  .fz-head__note {
    font-size: var(--fz-body-size);
    color: var(--fz-subheading);
  }

  .fz-head__action {
    margin-inline-start: auto;
    font-size: var(--fz-body-size);
    color: var(--fz-subheading);
    text-decoration: none;
    white-space: nowrap;
  }

  .fz-head__action:hover {
    color: var(--fz-text);
  }
</style>
