---
import { shot } from '../../lib/shot';
import SectionHead from './SectionHead.astro';
const items = [
  { tag:'Harvest', size:'3 kg', name:'Badami mangoes', price:'₹899', was:'₹990', maker:'Lakshmi Amma', ago:'2h ago', proof:'12 bought in the last hour', img:'/img/products/badami-mangoes.jpg' },
  { tag:'Fresh batch', size:'250 g', name:'Kodubale', price:'₹240', maker:'Savitri Rao', ago:'3h ago', proof:'96 cheered', img:'/img/products/kodubale.jpg' },
  { tag:'Harvest', size:'500 g', name:'Avarekalu', price:'₹120', maker:'Ganesh K', ago:'3h ago', img:'/img/products/avarekalu.jpg' },
  { tag:'15% off', size:'200 g', name:'Idli podi', price:'₹160', was:'₹190', maker:'Radha Devi', proof:'48 neighbours bought this', img:'/img/products/idli-podi.jpg' },
];
---

<section class="fz-shell fz-section">
  <SectionHead title="What's fresh today" note="Live from the community" action="→" />
  <div class="fz-fresh">
    {items.map((p) => (
      <article class="fz-prod fz-lift">
        <div class="fz-prod__media" style={shot(p.img)}>
          <span class="fz-prod__tag">{p.tag}</span>
          <button type="button" class="fz-btn fz-btn--primary fz-btn--sm fz-prod__buy">Buy</button>
        </div>
        <div class="fz-prod__body">
          <p class="fz-prod__size">{p.size}</p>
          <p class="fz-prod__name">{p.name}</p>
          <p class="fz-prod__price">
            {p.price}{p.was && <s>{p.was}</s>}
          </p>
          <p class="fz-prod__maker">
            <span class="fz-avatar fz-avatar--xs" aria-hidden="true"></span>
            {p.maker}{p.ago && ` · ${p.ago}`}
          </p>
          {p.proof && <p class="fz-prod__proof">{p.proof}</p>}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .fz-fresh {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--fz-card-grid-gap); /* 20 web / 12 mobile */
  }

  .fz-prod {
    height: var(--fz-prod-h);
    display: flex;
    flex-direction: column;
    /* Frame 57: r=10 with shadow 0,14 blur30 black 15% — and no stroke. */
    border-radius: var(--fz-radius-lg);
    box-shadow: var(--fz-card-shadow);
    background: var(--fz-site-bg);
    overflow: hidden;
  }

  .fz-prod__media {
    position: relative;
    /* Rectangle 5: 282x125 */
    height: 125px;
    flex: 0 0 125px;
    padding: 10px;
    background-color: var(--fz-panel);
    background-image: var(--fz-shot);
    background-size: cover;
    background-position: center;
  }

  .fz-prod__tag {
    position: absolute;
    top: 10px;
    left: 10px;
    /* Frame 47: fill #433139, text #eceaeb, r=8 */
    background: var(--fz-primary);
    color: var(--fz-primary-text);
    border-radius: var(--fz-radius-md);
    /* Capital text: 14px/18 w500 */
    font-size: var(--fz-capital-size);
    line-height: var(--fz-capital-lh);
    font-weight: 500;
    padding: 4px 6px;
    border-radius: var(--fz-radius-sm);
  }

  .fz-prod__buy {
    position: absolute;
    right: 10px;
    bottom: 10px;
  }

  .fz-prod__body {
    padding: 14px 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .fz-prod__size {
    /* Body text: 14px/18 */
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    color: var(--fz-subheading);
  }

  .fz-prod__name {
    font-family: var(--fz-font-display);
    font-size: var(--fz-product-size);
    line-height: var(--fz-product-lh);
  }

  .fz-prod__price {
    /* Para text 16px/21 */
    font-size: var(--fz-para-size);
    line-height: var(--fz-para-lh);
    font-weight: 600;
    display: flex;
    gap: 6px;
    align-items: baseline;
  }

  .fz-prod__price s {
    font-weight: 400;
    color: var(--fz-subheading);
    font-size: var(--fz-body-size);
  }

  .fz-prod__maker {
    display: flex;
    align-items: center;
    gap: 6px;
    /* The maker line is Sans 16px/21; only product names are Serif. */
    font-size: var(--fz-para-size);
    line-height: var(--fz-para-lh);
    margin-top: 2px;
  }

  .fz-avatar--xs {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--fz-panel-footer);
    display: inline-block;
  }

  .fz-prod__proof {
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    color: var(--fz-subheading);
  }

  /* Mobile layout lives in flavorz.css: a scoped rule here
     outranks the global carousel and forced a 2-up grid. */

  @media (max-width: 860px) {
    /* At the 179px mobile card width, text wraps instead of clipping. */
    .fz-prod__name,
    .fz-prod__proof,
    .fz-prod__maker,
    .fz-prod__price {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }
  }

  @media (max-width: 860px) {
    /*
     * The mobile frame lays this out as a single-height horizontal carousel.
     * This must live in the component: Astro scopes component CSS, so the
     * grid declaration above beats a global rule and squeezed each card to
     * 84px regardless of its flex-basis.
     */
    .fz-fresh {
      display: flex;
      gap: var(--fz-card-grid-gap);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .fz-fresh::-webkit-scrollbar {
      display: none;
    }

    .fz-fresh > .fz-prod {
      flex: 0 0 var(--fz-card-w);
      scroll-snap-align: start;
      /* The frame's 250px assumes shorter copy; grow rather than clip. */
      height: auto;
      min-height: var(--fz-prod-h);
    }
  }
</style>
