---
/**
 * Site header, built to the Figma frame.
 *
 * Three rows in the design:
 *   1. wordmark · search · social · online count · language · profile
 *   2. location · primary nav
 *   3. live activity ticker (its own component)
 */
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  online?: number;
  location?: string;
  cartCount?: number;
  crumbs?: Crumb[];
}

const nav = ['Offers', 'Community', 'Orders', 'Shop'];
const {
  online = 128,
  location = 'Jp Nagar, Bangalore',
  cartCount = 0,
  /** Breadcrumb trail, e.g. [{label:'Home',href:'/'}, {label:'Cart'}] */
  crumbs = [],
}: Props = Astro.props;
---

<header class="fz-header">
  <div class="fz-shell fz-header__top">
    <a class="fz-brand" href="/">
      <span class="fz-brand__mark" aria-hidden="true">f</span>
      <span class="fz-brand__name">Flavorz</span>
    </a>

    <form class="fz-search" role="search">
      <svg class="fz-search__icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
        ></path>
      </svg>
      <input
        type="search"
        aria-label="Search"
        placeholder='Search "avarekalu", "podi", "Lakshmi Amma"'
      />
      <button type="button" class="fz-search__mic" aria-label="Search by voice">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
          <rect x="6" y="2" width="4" height="7" rx="2" fill="currentColor"></rect>
          <path
            d="M4 8a4 4 0 0 0 8 0M8 12v2"
            stroke="currentColor"
            stroke-width="1.4"
            fill="none"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </form>

    <div class="fz-header__meta">
      <a class="fz-social" href="#" aria-label="YouTube">
        <svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true">
          <rect width="20" height="14" rx="4" fill="currentColor"></rect>
          <path d="M8 4l5 3-5 3z" fill="var(--fz-site-bg)"></path>
        </svg>
      </a>
      <a class="fz-social" href="#" aria-label="Instagram">
        <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true">
          <rect x="1" y="1" width="16" height="16" rx="5" fill="none" stroke="currentColor"
            stroke-width="1.6"></rect>
          <circle cx="9" cy="9" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6"
          ></circle>
          <circle cx="13.4" cy="4.6" r="1" fill="currentColor"></circle>
        </svg>
      </a>

      <span class="fz-online"><i aria-hidden="true"></i>{online} online now</span>

      <a class="fz-cart" href="/cart" aria-label={`Cart, ${cartCount} items`}>
        <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3 4h2l2 9h9l2-6H6" fill="none" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round"></path>
          <circle cx="9" cy="16" r="1.3" fill="currentColor"></circle>
          <circle cx="15" cy="16" r="1.3" fill="currentColor"></circle>
        </svg>
        {cartCount > 0 && <span class="fz-cart__count">{cartCount}</span>}
      </a>

      <div class="fz-lang" role="group" aria-label="Language">
        <button type="button" class="is-active">EN</button>
        <span aria-hidden="true">|</span>
        <button type="button">ಕನ್ನಡ</button>
      </div>

      <div class="fz-profile">
        <span class="fz-avatar fz-avatar--sm" aria-hidden="true">SR</span>
        <span class="fz-profile__tier">SILVER</span>
      </div>
    </div>
  </div>

  <div class="fz-shell fz-header__nav">
    <span class="fz-loc">
      <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true">
        <path
          d="M8 1.5a4.5 4.5 0 0 1 4.5 4.5c0 3.2-4.5 8.5-4.5 8.5S3.5 9.2 3.5 6A4.5 4.5 0 0 1 8 1.5Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"></path>
        <circle cx="8" cy="6" r="1.6" fill="currentColor"></circle>
      </svg>
      Home {location}
    </span>
    <nav aria-label="Primary">
      {nav.map((item) => <a href={`#${item.toLowerCase()}`}>{item}</a>)}
    </nav>
  </div>
  {
    crumbs.length > 0 && (
      <nav class="fz-shell fz-crumbs" aria-label="Breadcrumb">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span class="fz-crumbs__sep" aria-hidden="true">›</span>}
            {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </>
        ))}
      </nav>
    )
  }
</header>

<style>
  .fz-header {
    background: var(--fz-site-bg);
    border-bottom: 1px solid var(--fz-header-border);
  }

  .fz-header__top {
    display: flex;
    align-items: center;
    gap: 16px;
    /* Header frame is 88 tall overall: this row 52, the nav row 36. */
    height: 52px;
  }

  .fz-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--fz-text);
    flex: 0 0 auto;
  }

  .fz-brand__mark {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    border-radius: var(--fz-radius-md);
    background: #e8384f;
    color: #fff;
    font-family: var(--fz-font-display);
    font-size: 24px;
    line-height: 1;
  }

  .fz-brand__name {
    font-family: var(--fz-font-display);
    /* Logo Font: 36px/49 */
    font-size: var(--fz-logo-size);
    line-height: var(--fz-logo-lh);
  }

  .fz-search {
    position: relative;
    display: flex;
    align-items: center;
    /* Search bar is 442 wide in the frame. */
    flex: 0 1 442px;
    max-width: 442px;
  }

  .fz-search__icon {
    position: absolute;
    left: 14px;
    color: var(--fz-panel-text);
    pointer-events: none;
  }

  .fz-search input {
    width: 100%;
    font-family: var(--fz-font-body);
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    color: var(--fz-text);
    /* Search bar 442x36, r=10, fill #f2e1de, no stroke */
    height: var(--fz-search-h);
    padding: 8px 40px 8px 38px;
    border: 0;
    border-radius: var(--fz-radius-lg);
    background: var(--fz-panel);
    color: var(--fz-panel-text);
  }

  .fz-search input::placeholder {
    color: var(--fz-panel-text);
    opacity: 0.75;
  }

  .fz-search input {
    font-size: var(--fz-body-size);
  }

  .fz-search input:focus-visible {
    outline: 2px solid var(--fz-primary-focus);
    outline-offset: 1px;
  }

  .fz-search__mic {
    position: absolute;
    right: 12px;
    display: grid;
    place-items: center;
    border: 0;
    background: none;
    color: var(--fz-text);
    cursor: pointer;
    padding: 4px;
  }

  .fz-social {
    display: inline-grid;
    place-items: center;
    color: var(--fz-text);
    flex: 0 0 auto;
  }

  .fz-cart {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--fz-radius-lg);
    background: var(--fz-panel);
    color: var(--fz-panel-text);
    flex: 0 0 auto;
  }

  .fz-cart__count {
    position: absolute;
    top: -5px;
    right: -5px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    display: grid;
    place-items: center;
    border-radius: var(--fz-radius-pill);
    background: #e8384f;
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
  }

  .fz-crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-block: 14px 0;
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    color: var(--fz-subheading);
  }

  .fz-crumbs a {
    color: var(--fz-subheading);
    text-decoration: none;
  }

  .fz-crumbs a:hover {
    color: var(--fz-text);
  }

  .fz-crumbs [aria-current='page'] {
    color: var(--fz-text);
  }

  .fz-header__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 0 0 auto;
    margin-inline-start: auto;
  }

  .fz-online {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    /* "User Online" 128x22, fill #776870, text #f1f0f1, r=10 */
    background: var(--fz-online-fill);
    color: var(--fz-online-text);
    /* 14px/18 w400 */
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    padding: 2px 8px;
    border-radius: var(--fz-radius-lg);
    white-space: nowrap;
  }

  .fz-online i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .fz-lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    /* Language 103x40, r=10, 0.5px #433139 stroke */
    height: var(--fz-lang-h);
    border: 0.5px solid var(--fz-text);
    border-radius: var(--fz-radius-lg);
    padding: 0 16px;
    color: var(--fz-text);
    font-size: var(--fz-button-size);
    font-weight: 600;
  }

  .fz-lang button {
    border: 0;
    background: none;
    cursor: pointer;
    color: inherit;
    font: inherit;
    padding: 0;
  }

  .fz-lang button.is-active {
    color: var(--fz-text);
    font-weight: 600;
  }

  .fz-profile {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    line-height: 1;
    /* The avatar ring is drawn with box-shadow spread, which is outside the
       box: reserve the space so it cannot collide with the online pill. */
    padding: 4px;
  }

  .fz-avatar {
    display: grid;
    place-items: center;
    border-radius: 50%;
    /* Inner circle #433139 with a 2px ring in the frame. */
    background: var(--fz-primary);
    color: var(--fz-primary-text);
    font-weight: 600;
    box-shadow: 0 0 0 2px var(--fz-site-bg), 0 0 0 4px var(--fz-primary);
  }

  .fz-avatar--sm {
    width: 36px;
    height: 36px;
    font-size: var(--fz-body-size);
  }

  .fz-profile__tier {
    /* Badge 99x26, fill #776870, text #f1f0f1, r=100 */
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    background: var(--fz-secondary);
    color: var(--fz-secondary-text);
    padding: 2px 12px;
    border-radius: var(--fz-radius-pill);
  }

  .fz-header__nav {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 36px;
  }

  .fz-loc {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    /* 16px/21 w600 in the frame */
    font-size: var(--fz-button-size);
    line-height: var(--fz-button-lh);
    font-weight: 600;
    color: var(--fz-text);
    white-space: nowrap;
  }

  .fz-header__nav nav {
    display: flex;
    /* Frame: Offers 639, Community 719, Orders 842, Shop 928 — the row begins
       at 639 within a content column starting at 120, i.e. 519px in. */
    gap: 32px;
    margin-inline-start: 277px;
  }

  .fz-header__nav a {
    color: var(--fz-text);
    text-decoration: none;
    /* Button text: 16px/21 w600 */
    font-size: var(--fz-button-size);
    line-height: var(--fz-button-lh);
    font-weight: 600;
  }

  .fz-header__nav a:hover {
    color: var(--fz-primary-hover);
  }

  @media (max-width: 640px) {
    .fz-header__top {
      flex-wrap: wrap;
      row-gap: 10px;
    }
    .fz-search {
      order: 10;
      flex: 1 1 100%;
      max-width: none;
    }
    .fz-social {
    display: inline-grid;
    place-items: center;
    color: var(--fz-text);
    flex: 0 0 auto;
  }

  .fz-cart {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--fz-radius-lg);
    background: var(--fz-panel);
    color: var(--fz-panel-text);
    flex: 0 0 auto;
  }

  .fz-cart__count {
    position: absolute;
    top: -5px;
    right: -5px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    display: grid;
    place-items: center;
    border-radius: var(--fz-radius-pill);
    background: #e8384f;
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
  }

  .fz-crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-block: 14px 0;
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    color: var(--fz-subheading);
  }

  .fz-crumbs a {
    color: var(--fz-subheading);
    text-decoration: none;
  }

  .fz-crumbs a:hover {
    color: var(--fz-text);
  }

  .fz-crumbs [aria-current='page'] {
    color: var(--fz-text);
  }

  .fz-header__meta {
      margin-inline-start: auto;
    }
    .fz-online,
    .fz-social {
      display: none;
    }
    .fz-header__nav {
      gap: 12px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .fz-header__nav::-webkit-scrollbar {
      display: none;
    }
    .fz-header__nav nav {
      gap: 16px;
    }
  }
</style>
