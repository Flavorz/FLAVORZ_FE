---
import { shot } from '../../lib/shot';
import SectionHead from './SectionHead.astro';
const makers = [
  { name:'Lakshmi Amma', meta:'Madurai · 2.4k', img:'/img/makers/lakshmi-amma.jpg' },
  { name:'Savitri Rao', meta:'Guntur · 1.9k', img:'/img/makers/savitri-rao.jpg' },
  { name:'Ganesh K', meta:'Dharwad · 1.2k', img:'/img/makers/ganesh-k.jpg' },
  { name:'Radha Devi', meta:'Mysore · 640', img:'/img/makers/radha-devi.jpg' },
];
---

<section class="fz-shell fz-section">
  <SectionHead title="Meet the makers" />
  <ul class="fz-makers">
    {makers.map((m) => (
      <li>
        <span class="fz-makers__photo" style={shot(m.img)} aria-hidden="true"></span>
        <p class="fz-makers__name">{m.name}</p>
        <p class="fz-makers__meta">{m.meta}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .fz-makers {
    display: grid;
    grid-template-columns: repeat(4, 160px);
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fz-makers li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .fz-makers__photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background-color: var(--fz-panel);
    background-image: var(--fz-shot);
    background-size: cover;
    background-position: center;
  }

  .fz-makers__name {
    font-family: var(--fz-font-display);
    /* Product names: 16px/22 Serif */
    font-size: var(--fz-product-size);
    line-height: var(--fz-product-lh);
    margin-top: 6px;
  }

  .fz-makers__meta {
    /* Body text 14px/18 */
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    color: var(--fz-subheading);
  }

  /* Mobile layout lives in flavorz.css: a scoped rule here
     outranks the global carousel and forced a 2-up grid. */

  @media (max-width: 860px) {
    /*
     * The mobile frame lays this out as a single-height horizontal carousel.
     * This must live in the component: Astro scopes component CSS, so the
     * grid declaration above beats a global rule and squeezed each card to
     * 84px regardless of its flex-basis.
     */
    .fz-makers {
      display: flex;
      gap: var(--fz-card-grid-gap);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .fz-makers::-webkit-scrollbar {
      display: none;
    }

    .fz-makers > li {
      flex: 0 0 var(--fz-card-w);
      scroll-snap-align: start;
    }
  }
</style>
