---
const promos = [
  { tag: 'IN SEASON', title: 'Mango season\nis here', cta: 'Shop Mangoes', tone: 'panel' },
  { tag: 'ZERO COMMISSION', title: '100% of the price\ngoes to the maker', body: 'You pay ₹220, Radha gets ₹220', tone: 'dark' },
  { tag: 'FESTIVE', title: 'Diwali boxes\npre-order now', tone: 'mid' },
];
---

<section class="fz-shell fz-promos">
  {promos.map((p) => (
    <article class:list={['fz-promo', 'fz-lift', `fz-promo--${p.tone}`]}>
      <p class="fz-promo__tag">{p.tag}</p>
      <h3 class="fz-promo__title">{p.title}</h3>
      {p.body && <p class="fz-promo__body">{p.body}</p>}
      {p.cta && <button type="button" class="fz-btn fz-btn--primary fz-btn--sm">{p.cta}</button>}
    </article>
  ))}
</section>

<style>
  .fz-promos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--fz-gap-20);
    margin-top: 58px;
  }

  .fz-promo {
    border-radius: var(--fz-radius-md); /* r=8 in the frame */
    padding: 18px 20px;
    min-height: 152px; /* 385x152 */
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .fz-promo--panel {
    background: var(--fz-panel);
    color: var(--fz-panel-text);
  }

  .fz-promo--dark {
    background: var(--fz-primary);
    color: var(--fz-primary-text);
  }

  .fz-promo--mid {
    background: var(--fz-secondary);
    color: var(--fz-secondary-text);
  }

  .fz-promo__tag {
    /* Capital text: 14px/18 w500 */
    font-size: var(--fz-capital-size);
    line-height: var(--fz-capital-lh);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .fz-promo__title {
    font-family: var(--fz-font-display);
    font-size: var(--fz-h2-size);
    line-height: var(--fz-h2-lh);
    white-space: pre-line;
    margin: 0;
  }

  .fz-promo__body {
    /* Frame y=645: 14px/18. */
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    opacity: 0.9;
  }

  .fz-promo .fz-btn {
    align-self: flex-start;
    margin-top: auto;
  }

  @media (max-width: 860px) {
    /* Frame 219: a 110-tall horizontal row, not a 2-up grid. */
    .fz-promos {
      display: flex;
      gap: 24px;
      overflow-x: auto;
      scrollbar-width: none;
      margin-top: 40px;
    }

    .fz-promos::-webkit-scrollbar {
      display: none;
    }

    .fz-promo {
      flex: 0 0 191px;
      min-height: 110px;
      padding: 12px 14px;
    }
  }
</style>
