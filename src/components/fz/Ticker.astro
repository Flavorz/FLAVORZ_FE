---
const items = [
  'Meena in Mysuru just bought Sambar mix · 2 min ago',
  'Super shopper · ₹1,580 to Gold',
  'Leading comments · Meena shared 12 helpful tips',
  'Delivery by tomorrow · Pay on delivery',
  'Content leader · Lakshmi Amma posted 5 harvest stories',
  'Welcome back, Saranya',
];
---

<div class="fz-ticker">
  <div class="fz-shell fz-ticker__row">
    <span class="fz-ticker__live"><i aria-hidden="true"></i>Live</span>
    {items.map((t) => <span class="fz-ticker__item">{t}</span>)}
  </div>
</div>

<style>
  .fz-ticker {
    background: var(--fz-panel);
    color: var(--fz-panel-text);
    /* Frame 158 sits at y=148, 60 below the 88-tall header. */
    margin-top: 60px;
  }

  .fz-ticker__row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-block: 10px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .fz-ticker__row::-webkit-scrollbar {
    display: none;
  }

  .fz-ticker__live {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #e8384f;
    color: #fff;
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    padding: 2px 9px;
    border-radius: var(--fz-radius-pill);
    flex: 0 0 auto;
  }

  .fz-ticker__live i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }

  .fz-ticker__item {
    /* Each item is a white pill (r=8) on the blush strip. */
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    white-space: nowrap;
    flex: 0 0 auto;
    background: var(--fz-site-bg);
    border-radius: var(--fz-radius-md);
    padding: 4px 6px;
  }
</style>
