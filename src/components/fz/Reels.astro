---
import { shot } from '../../lib/shot';
import SectionHead from './SectionHead.astro';
const reels = [
  { kind: 'Making', maker: 'Lakshmi Amma', caption: 'Grinding idli podi', product: 'Idli podi', price: '₹ 120', img: '/img/reels/idli-podi.jpg' },
  { kind: 'Harvest', maker: 'Ganesh K', caption: 'Avarekalu this morning', product: 'Avarekalu', price: '₹ 160', img: '/img/reels/avarekalu.jpg' },
  { kind: 'Packing', maker: 'Savitri Rao', caption: 'Packing gongura pickle', product: 'Gongura', price: '₹ 210', img: '/img/reels/gongura.jpg' },
  { kind: 'Unboxing', maker: 'Rekha K', caption: 'Opening her jaggery order', product: 'Jaggery', price: '₹ 150', img: '/img/reels/jaggery.jpg' },
];
---

<section class="fz-shell fz-section">
  <SectionHead title="Reels" action="See all reels" />
  <div class="fz-reels">
    {reels.map((r) => (
      <article class="fz-reel fz-lift">
        <div class="fz-reel__media" style={shot(r.img)}>
          <span class="fz-reel__kind">{r.kind}</span>
          <div class="fz-reel__who">
            <p class="fz-reel__maker">{r.maker}</p>
            <p class="fz-reel__caption">{r.caption}</p>
          </div>
        </div>
        <div class="fz-reel__buy">
          <div>
            <p class="fz-reel__product">{r.product}</p>
            <p class="fz-reel__price">{r.price}</p>
          </div>
          <button type="button" class="fz-btn fz-btn--primary fz-btn--sm">Buy</button>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .fz-reels {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--fz-card-grid-gap); /* 20 web / 12 mobile */
  }

  .fz-reel {
    height: var(--fz-reel-h);
    display: flex;
    flex-direction: column;
    /* Frame 57: r=10 with shadow 0,14 blur30 black 15% — and no stroke. */
    border-radius: var(--fz-radius-lg);
    box-shadow: var(--fz-card-shadow);
    background: var(--fz-site-bg);
    overflow: hidden;
  }

  /*
   * Text sits ON the photograph here, so the image is a background rather than
   * an <img>: an image in the flow pushes the overlay content below it.
   * --fz-shot is set per card; the panel colour shows through until the file
   * exists, so a missing photo degrades to the design's placeholder.
   */
  .fz-reel__media {
    position: relative;
    /* 326 total card height minus the buy row. */
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 10px;
    color: var(--fz-panel-text);
    background-color: var(--fz-panel);
    background-image: var(--fz-shot);
    background-size: cover;
    background-position: center;
  }

  .fz-reel__kind {
    align-self: flex-start;
    background: var(--fz-primary);
    color: var(--fz-primary-text);
    border-radius: var(--fz-radius-md);
    font-size: var(--fz-capital-size);
    line-height: var(--fz-capital-lh);
    font-weight: 500;
    padding: 4px 6px;
    border-radius: var(--fz-radius-sm);
  }

  .fz-reel__who {
    margin-top: auto;
    /* Keep the caption legible over photography. */
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
  }

  .fz-reel__maker {
    /* 18px/23 w600 Sans in BOTH frames — it does not scale down on mobile. */
    font-size: 18px;
    line-height: 23px;
    font-weight: 600;
  }

  .fz-reel__caption {
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    opacity: 0.85;
  }

  .fz-reel__buy {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
  }

  .fz-reel__buy > div {
    min-width: 0;
  }

  .fz-reel__product {
    /* Product names are Serif Display 16/22. */
    font-family: var(--fz-font-display);
    font-size: var(--fz-product-size);
    line-height: var(--fz-product-lh);
    color: var(--fz-subheading);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .fz-reel__price {
    font-size: var(--fz-para-size);
    line-height: var(--fz-para-lh);
    font-weight: 600;
  }

  .fz-reel__buy .fz-btn {
    margin-inline-start: auto;
  }

  /* Mobile layout lives in flavorz.css: a scoped rule here
     outranks the global carousel and forced a 2-up grid. */

  @media (max-width: 860px) {
    /* At the 179px mobile card width, text wraps instead of clipping. */
    .fz-reel__product,
    .fz-reel__maker,
    .fz-reel__caption {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }
  }

  @media (max-width: 860px) {
    /*
     * The mobile frame lays this out as a single-height horizontal carousel.
     * This must live in the component: Astro scopes component CSS, so the
     * grid declaration above beats a global rule and squeezed each card to
     * 84px regardless of its flex-basis.
     */
    .fz-reels {
      display: flex;
      gap: var(--fz-card-grid-gap);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .fz-reels::-webkit-scrollbar {
      display: none;
    }

    .fz-reels > .fz-reel {
      flex: 0 0 var(--fz-card-w);
      scroll-snap-align: start;
    }
  }
</style>
