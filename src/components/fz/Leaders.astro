---
import SectionHead from './SectionHead.astro';
const boards = [
  { title:'Super shoppers', rows:[['1','Meena','Platinum'],['2','Rekha K','Gold'],['3','You','Silver']] },
  { title:'Leading comments', rows:[['1','Meena','48 comments'],['2','Ganesh M','31 comments'],['3','Rekha K','22 comments']] },
  { title:'Content leaders', rows:[['1','Lakshmi amma','12 posts'],['2','Savitri Rao','9 posts'],['3','Radha Devi','7 posts']] },
];
---

<section class="fz-shell fz-section">
  <SectionHead title="Community leaders" note="This week. Placeholder, scoring rules to come." action="See full leaderboard" />
  <div class="fz-boards">
    {boards.map((b) => (
      <article class="fz-board">
        <p class="fz-board__title"><i aria-hidden="true"></i>{b.title}</p>
        <ul>
          {b.rows.map(([rank, name, detail]) => (
            <li>
              <span class="fz-board__rank">{rank}</span>
              <span class="fz-avatar fz-avatar--xs" aria-hidden="true"></span>
              <span class="fz-board__name">{name}</span>
              <span class:list={['fz-board__detail', detail.includes(' ') ? '' : 'is-pill']}>{detail}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .fz-boards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .fz-board {
    background: var(--fz-panel);
    border-radius: var(--fz-radius-md);
    padding: 14px 16px;
  }

  .fz-board__title {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: var(--fz-body-size);
    font-weight: 600;
    margin-bottom: 10px;
  }

  .fz-board__title i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.4px solid currentColor;
  }

  .fz-board ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .fz-board li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }

  .fz-board__rank {
    width: 10px;
    color: var(--fz-subheading);
  }

  .fz-board__name {
    flex: 1 1 auto;
  }

  .fz-board__detail {
    color: var(--fz-subheading);
    white-space: nowrap;
  }

  .fz-board__detail.is-pill {
    background: var(--fz-primary);
    color: var(--fz-primary-text);
    padding: 2px 9px;
    border-radius: var(--fz-radius-pill);
    font-size: 10px;
  }

  @media (max-width: 860px) {
    .fz-boards {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .fz-boards::-webkit-scrollbar { display: none; }
    .fz-board {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
  }
</style>
