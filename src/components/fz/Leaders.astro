---
import SectionHead from './SectionHead.astro';
interface Row {
  rank: string;
  name: string;
  detail: string;
  /** Tier names render as a filled pill; metrics render as plain text. */
  isTier?: boolean;
}

const boards: Array<{ title: string; rows: Row[] }> = [
  {
    title: 'Super shoppers',
    rows: [
      { rank: '1', name: 'Meena', detail: 'Platinum', isTier: true },
      { rank: '2', name: 'Rekha K', detail: 'Gold', isTier: true },
      { rank: '3', name: 'You', detail: 'Silver', isTier: true },
    ],
  },
  {
    title: 'Leading comments',
    rows: [
      { rank: '1', name: 'Meena', detail: '48 comments' },
      { rank: '2', name: 'Ganesh M', detail: '31 comments' },
      { rank: '3', name: 'Rekha K', detail: '22 comments' },
    ],
  },
  {
    title: 'Content leaders',
    rows: [
      { rank: '1', name: 'Lakshmi amma', detail: '12 posts' },
      { rank: '2', name: 'Savitri Rao', detail: '9 posts' },
      { rank: '3', name: 'Radha Devi', detail: '7 posts' },
    ],
  },
];
---

<section class="fz-shell fz-section">
  <SectionHead title="Community leaders" note="This week. Placeholder, scoring rules to come." action="See full leaderboard" />
  <div class="fz-boards">
    {boards.map((b) => (
      <article class="fz-board">
        <p class="fz-board__title"><i aria-hidden="true"></i>{b.title}</p>
        <ul>
          {b.rows.map((row) => (
            <li>
              <span class="fz-board__rank">{row.rank}</span>
              <span class="fz-avatar fz-avatar--xs" aria-hidden="true"></span>
              <span class="fz-board__name">{row.name}</span>
              <span class:list={['fz-board__detail', row.isTier && 'is-pill']}>{row.detail}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .fz-boards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--fz-gap-24); /* Frame 210 gap=24 */
  }

  .fz-board {
    background: var(--fz-panel);
    border-radius: var(--fz-radius-lg);
    /* Frame 210 is 234 tall. */
    min-height: 234px;
    padding: 20px 24px;
  }

  .fz-board__title {
    display: flex;
    align-items: center;
    gap: 7px;
    /* Leaderboard titles are 18px/23 w600 in the frame. */
    font-size: var(--fz-name-size);
    line-height: var(--fz-name-lh);
    font-weight: 600;
    margin-bottom: 18px;
  }

  .fz-board__title i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.4px solid currentColor;
  }

  .fz-board ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fz-board li {
    display: flex;
    align-items: center;
    gap: 8px;
    /* Rows are 16px/21 Sans 400. */
    font-size: var(--fz-para-size);
    line-height: var(--fz-para-lh);
  }

  .fz-board__rank {
    width: 10px;
    color: var(--fz-subheading);
  }

  .fz-board__name {
    flex: 1 1 auto;
    /* Leaderboard names are Sans 16/21, not Serif. */
    font-family: var(--fz-font-body);
  }

  .fz-board__detail {
    color: var(--fz-subheading);
    white-space: nowrap;
  }

  .fz-board__detail.is-pill {
    background: var(--fz-primary);
    color: var(--fz-primary-text);
    padding: 2px 9px;
    border-radius: var(--fz-radius-pill);
    font-size: var(--fz-body-size);
  }

  @media (max-width: 860px) {
    .fz-boards {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .fz-boards::-webkit-scrollbar { display: none; }
    .fz-board {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
  }
</style>
