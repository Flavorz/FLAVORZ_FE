---
/** Right column of the cart: address, offer, tier, totals, payment, CTA. */
const { cta = 'Place Order', ctaNote = 'Pay ₹790 on delivery' } = Astro.props;

const rows = [
  { label: 'Item total', value: '₹830' },
  { label: 'Offer discount', value: '−₹60' },
  { label: 'Delivery fee (placeholder)', value: '−₹40' },
  { label: 'Silver delivery perk (placeholder)', value: '−₹20' },
];
---

<aside class="fz-summary">
  <h2 class="fz-summary__title">Order summary</h2>

  <div class="fz-summary__addr">
    <p class="fz-summary__addrTop">
      <span class="fz-summary__pin" aria-hidden="true">
        <svg width="13" height="13" viewBox="0 0 16 16">
          <path d="M8 1.5a4.5 4.5 0 0 1 4.5 4.5c0 3.2-4.5 8.5-4.5 8.5S3.5 9.2 3.5 6A4.5 4.5 0 0 1 8 1.5Z"
            fill="none" stroke="currentColor" stroke-width="1.3" />
          <circle cx="8" cy="6" r="1.5" fill="currentColor" />
        </svg>
      </span>
      <b>Home</b>
      <a href="#">Change</a>
    </p>
    <p class="fz-summary__addrLine">Jp Nagar, Bangalore</p>
    <p class="fz-summary__addrLine">
      +91 98XXX XX123
      <span class="fz-verified-sm">
        <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="7" fill="currentColor" />
          <path d="M5 8.4l2 2L11 6" fill="none" stroke="var(--fz-panel)" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Verified
      </span>
    </p>
    <p class="fz-summary__addrLine">Delivery by tomorrow · Sat 10 Oct</p>
  </div>

  <form class="fz-offer">
    <input type="text" aria-label="Offer code" placeholder="Have an offer code?" />
    <button type="button" class="fz-btn fz-btn--primary fz-btn--sm">Apply</button>
  </form>

  <div class="fz-tier-note">
    <p class="fz-tier-note__head">
      <span class="fz-tier-note__dot" aria-hidden="true"></span>
      <b>Silver shopper</b> · This order takes you to ₹4,190.
    </p>
    <span class="fz-tier-note__track"><i></i></span>
    <p class="fz-tier-note__scale">
      <span>₹810 more to reach <b>Gold</b></span>
      <span>Platinum ₹10,000</span>
    </p>
  </div>

  <dl class="fz-totals">
    {rows.map((r) => (<><dt>{r.label}</dt><dd>{r.value}</dd></>))}
    <dt class="fz-totals__pay">To pay</dt>
    <dd class="fz-totals__pay">₹790</dd>
  </dl>

  <label class="fz-pay">
    <input type="radio" name="pay" checked />
    <span class="fz-pay__icon" aria-hidden="true">
      <svg width="18" height="14" viewBox="0 0 20 16">
        <rect x="1" y="2" width="18" height="12" rx="2" fill="none" stroke="currentColor"
          stroke-width="1.4" />
        <path d="M1 6h18" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </span>
    <span class="fz-pay__body">
      <b>Pay on delivery</b>
      <small>Cash or UPI at your door</small>
    </span>
  </label>

  <p class="fz-zero">
    <b>Zero commission.</b> all ₹770 of item price goes to the makers: Lakshmi Amma ₹320 and
    Savitri Rao ₹450
  </p>

  <a class="fz-btn fz-btn--primary fz-summary__cta" href="/payment">
    <b>{cta}</b>
    <small>{ctaNote}</small>
  </a>
</aside>

<style>
  .fz-summary {
    border: 1px solid var(--fz-header-border);
    border-radius: var(--fz-radius-lg);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fz-summary__title {
    font-family: var(--fz-font-display);
    font-size: var(--fz-h1-size);
    line-height: var(--fz-h1-lh);
    margin: 0;
  }

  .fz-summary__addr {
    background: var(--fz-panel);
    border-radius: var(--fz-radius-md);
    padding: 14px 16px;
    color: var(--fz-panel-text);
  }

  .fz-summary__addrTop {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: var(--fz-para-size);
    line-height: var(--fz-para-lh);
  }

  .fz-summary__addrTop a {
    margin-inline-start: auto;
    color: inherit;
    font-size: var(--fz-body-size);
  }

  .fz-summary__addrLine {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    margin-top: 3px;
  }

  .fz-verified-sm {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-inline-start: auto;
    color: var(--fz-secondary);
  }

  .fz-offer {
    display: flex;
    gap: 10px;
    border: 1px solid var(--fz-header-border);
    border-radius: var(--fz-radius-md);
    padding: 8px 10px;
    align-items: center;
  }

  .fz-offer input {
    flex: 1 1 auto;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--fz-body-size);
    color: var(--fz-text);
  }

  .fz-offer input::placeholder {
    color: var(--fz-subheading);
  }

  .fz-tier-note {
    background: var(--fz-panel);
    border-radius: var(--fz-radius-md);
    padding: 12px 14px;
    color: var(--fz-panel-text);
  }

  .fz-tier-note__head {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
  }

  .fz-tier-note__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }

  .fz-tier-note__track {
    display: block;
    height: 4px;
    border-radius: var(--fz-radius-pill);
    background: var(--fz-panel-footer);
    margin: 10px 0 7px;
  }

  .fz-tier-note__track i {
    display: block;
    width: 42%;
    height: 100%;
    border-radius: var(--fz-radius-pill);
    background: var(--fz-primary);
  }

  .fz-tier-note__scale {
    display: flex;
    justify-content: space-between;
    font-size: var(--fz-body-size);
  }

  .fz-totals {
    display: grid;
    grid-template-columns: 1fr auto;
    row-gap: 8px;
    margin: 0;
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
  }

  .fz-totals dd {
    margin: 0;
    text-align: end;
  }

  .fz-totals__pay {
    font-size: var(--fz-para-size);
    font-weight: 600;
    padding-top: 10px;
    border-top: 1px solid var(--fz-header-border);
  }

  .fz-pay {
    display: flex;
    align-items: center;
    gap: 11px;
    border: 1px solid var(--fz-stroke-ink);
    border-radius: var(--fz-radius-md);
    padding: 12px 14px;
    cursor: pointer;
  }

  .fz-pay__body b {
    display: block;
    font-size: var(--fz-para-size);
    line-height: var(--fz-para-lh);
    font-weight: 600;
  }

  .fz-pay__body small {
    display: block;
    font-size: var(--fz-body-size);
    color: var(--fz-subheading);
  }

  .fz-zero {
    background: var(--fz-panel);
    border-radius: var(--fz-radius-md);
    padding: 12px 14px;
    font-size: var(--fz-body-size);
    line-height: var(--fz-body-lh);
    color: var(--fz-panel-text);
  }

  .fz-summary__cta {
    flex-direction: column;
    gap: 1px;
    padding-block: 11px;
    text-decoration: none;
  }

  .fz-summary__cta b {
    font-size: var(--fz-para-size);
    line-height: var(--fz-para-lh);
    font-weight: 600;
  }

  .fz-summary__cta small {
    font-size: var(--fz-body-size);
    opacity: 0.88;
  }
</style>
