# Public site URL, used for sitemap generation.
PUBLIC_SITE_URL=https://example.com

# Where tenant theme CSS is served from. Override if themes live on a
# separate CDN path or bucket.
# PUBLIC_THEME_BASE=/themes

# Tenant config API. Unused until the backend exists; see README.
# PUBLIC_TENANT_API=https://api.example.com

# ─────────────────────────────────────────────────────────────────────
# Figma — used only by scripts/figma-pull.mjs, never shipped to the browser.
#
# TOKEN:  Figma → Settings → Security → Personal access tokens → Generate.
#         Scopes: file_content:read, and file_variables:read for Variables.
#         This grants READ ACCESS TO ALL YOUR FIGMA FILES — treat it like a
#         password. .env is gitignored; never commit it or paste it in chat.
#
# FILE:   from the URL figma.com/design/<FILE_KEY>/Some-Name
# ─────────────────────────────────────────────────────────────────────
# FIGMA_TOKEN=<your figma personal access token>
# FIGMA_FILE_KEY=xxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────
# Content source.
#
#   mock (default) — the JSON in src/content/
#   api            — the real backend; PUBLIC_API_BASE_URL must be set
#
# Switching is an env change; no code moves. See src/lib/data/.
# ─────────────────────────────────────────────────────────────────────
PUBLIC_CONTENT_SOURCE=mock
# PUBLIC_API_BASE_URL=https://api.theflavorz.com/v1
